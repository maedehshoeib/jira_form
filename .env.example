# Replace all example credentials before production deployment.
POSTGRES_DB=portal
POSTGRES_USER=portal
POSTGRES_PASSWORD=replace-before-production
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://portal:replace-before-production@postgres:5432/portal
CONTRACTS_DATABASE_URL=postgresql+psycopg://portal:replace-before-production@postgres:5432/portal

# Keep this enabled for the first production start with the existing portal_data
# volume. The import is transactional and records an idempotent completion marker.
SQLITE_MIGRATION_ENABLED=true
SQLITE_SOURCE_DATABASE_URL=sqlite:////app/data/portal.db
SQLITE_CONTRACTS_SOURCE_DATABASE_URL=sqlite:////app/data/contracts.db
DATABASE_MIGRATIONS_ENABLED=true

SECRET_KEY=replace-with-a-long-random-secret
USERS_SEED_ENABLED=true
USERS_SEED_FILE=/users.xlsx
DEFAULT_USER_PASSWORD=replace-before-production
TIMESHEET_DEMO_USERNAME=ma.shoeib
ADMIN_USERNAME=portal.admin
ADMIN_PASSWORD=replace-before-production
ADMIN_MAX_DEVICES=4
JIRA_BASE_URL=https://jira.example.com
JIRA_ENABLED=false
JIRA_USERNAME=
JIRA_PASSWORD=
REPORTS_API_KEY=replace-before-production
