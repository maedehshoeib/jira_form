APP_NAME=سامانه جامع خدمات
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:8000
DATABASE_URL=sqlite:///./data/portal.db
CONTRACTS_DATABASE_URL=sqlite:///./data/contracts.db
SECRET_KEY=replace-with-a-long-random-production-secret

# Local employee authentication
USERS_SEED_ENABLED=true
USERS_SEED_FILE=../users.xlsx
DEFAULT_USER_PASSWORD=Secure@1234567

# Jira ScriptRunner APIs (not used for login)
JIRA_BASE_URL=https://jira.vosouq.me
JIRA_ENABLED=true
JIRA_USERNAME=
JIRA_PASSWORD=

# API key for Jira admin to fetch reports
REPORTS_API_KEY=replace-with-a-production-api-key

UPLOAD_DIR=./data/uploads
CONTRACTS_UPLOAD_DIR=./data/contracts_uploads
