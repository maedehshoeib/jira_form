APP_NAME=سامانه جامع خدمات
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:8000
DATABASE_URL=sqlite:///./data/portal.db
CONTRACTS_DATABASE_URL=sqlite:///./data/contracts.db
SECRET_KEY=change-me-in-production-use-a-long-random-string

# LDAP / Active Directory
LDAP_ENABLED=true
LDAP_SERVER=ldap://dc.vosouq.local
LDAP_PORT=389
LDAP_USE_SSL=false
LDAP_BASE_DN=DC=vosouq,DC=local
LDAP_USER_DN_TEMPLATE={username}@vosouq.local
LDAP_TIMEOUT=5

# Dev fallback (when not on internal network)
DEV_AUTH_ENABLED=true
DEV_AUTH_USERNAME=admin
DEV_AUTH_PASSWORD=admin

# Jira ScriptRunner APIs
JIRA_BASE_URL=https://jira.vosouq.me
JIRA_ENABLED=true
JIRA_USERNAME=
JIRA_PASSWORD=

# API key for Jira admin to fetch reports
REPORTS_API_KEY=jira-admin-reports-key

UPLOAD_DIR=./data/uploads
CONTRACTS_UPLOAD_DIR=./data/contracts_uploads
