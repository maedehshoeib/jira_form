APP_NAME=سامانه جامع خدمات
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:8000
DATABASE_URL=postgresql+psycopg://portal:replace-before-production@localhost:5432/portal
CONTRACTS_DATABASE_URL=postgresql+psycopg://portal:replace-before-production@localhost:5432/portal
SQLITE_MIGRATION_ENABLED=true
SQLITE_SOURCE_DATABASE_URL=sqlite:///./data/portal.db
SQLITE_CONTRACTS_SOURCE_DATABASE_URL=sqlite:///./data/contracts.db
DATABASE_MIGRATIONS_ENABLED=true
SECRET_KEY=replace-with-a-long-random-production-secret

# Local employee authentication
USERS_SEED_ENABLED=true
USERS_SEED_FILE=../users.xlsx
DEFAULT_USER_PASSWORD=Secure@1234567

# Idempotent timesheet preview data for the admin dashboard and this user
TIMESHEET_SEED_ENABLED=true
TIMESHEET_DEMO_USERNAME=ma.shoeib

# Jira ScriptRunner APIs (not used for login)
JIRA_BASE_URL=https://jira.vosouq.me
JIRA_ENABLED=true
JIRA_USERNAME=
JIRA_PASSWORD=

# API key for Jira admin to fetch reports
REPORTS_API_KEY=replace-with-a-production-api-key

